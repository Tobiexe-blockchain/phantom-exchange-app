# The three backend services this app talks to (all on a private network in production).
AUTH_URL=http://localhost:3001
WALLET_URL=http://localhost:3002
LEDGER_URL=http://localhost:3010

# Same value as API_KEY in phantom-wallet. Stays on the server, never sent to the browser.
WALLET_API_KEY=

# Same value as WEBHOOK_SECRET in phantom-wallet. Used to check that deposit and withdrawal events are real.
WALLET_WEBHOOK_SECRET=

# Cookies are sent over HTTPS only in production. Set false to test over plain http on localhost.
# COOKIE_SECURE=true
